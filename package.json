{
  "name": "personal-assistant-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.53.0",
  "description": "Pandeck: a self-hosted web UI and server for supervising AI agent sessions",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta --restart-tries -1 --restart-after 1000 \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @assistant/server dev",
    "dev:web": "pnpm --filter @assistant/web dev",
    "build": "pnpm --filter @assistant/web build",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "check:apns": "pnpm --filter @assistant/server check:apns",
    "check:instructions": "node scripts/check-instruction-docs.mjs",
    "check:migrations": "node scripts/check-migrations-lock.mjs",
    "check:package-config-secrets": "node scripts/check-package-config-secrets.mjs",
    "check:prompts": "pnpm --filter @assistant/server check:prompts",
    "format": "prettier --experimental-cli --write --cache .",
    "format:check": "prettier --experimental-cli --check --cache .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:deadcode": "node scripts/check-deadcode.mjs",
    "measure:prompts": "pnpm --filter @assistant/server measure:prompts",
    "measure:session": "pnpm --filter @assistant/server measure:session",
    "measure:tasks": "pnpm --filter @assistant/server measure:tasks",
    "measure:tools": "pnpm --filter @assistant/server measure:tools",
    "measure:web": "pnpm build && node scripts/measure-web-build.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "start": "pnpm --filter @assistant/server start",
    "test": "pnpm run check:instructions && pnpm run check:migrations && pnpm run check:package-config-secrets && pnpm run lint && pnpm run lint:deadcode && pnpm run test:suites",
    "test:kb": "node scripts/run-kb-tests.mjs all",
    "test:package-config-secrets": "node --test scripts/check-package-config-secrets.test.mjs",
    "test:release": "node --test scripts/release-utils.test.mjs",
    "test:server": "pnpm --filter @assistant/server test",
    "test:suites": "pnpm run test:release && pnpm run test:package-config-secrets && pnpm --filter '@assistant/*' --parallel --no-bail test",
    "test:web": "pnpm --filter @assistant/web test",
    "stt:model": "node scripts/install-stt-model.mjs",
    "typecheck": "pnpm --filter '@assistant/*' --parallel --no-bail typecheck",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "concurrently": "catalog:",
    "esbuild": "catalog:",
    "knip": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:codemods"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.9.0"
  }
}
