{
  "name": "@assistant/server",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.53.0",
  "scripts": {
    "check:apns": "tsx src/checkApnsCredential.ts",
    "check:prompts": "tsx src/checkPromptBudgets.ts",
    "dev": "tsx src/dev-supervisor.ts",
    "measure:prompts": "tsx src/measurePrompts.ts",
    "measure:output-policy": "tsx src/measureOutputPolicy.ts",
    "measure:session": "tsx src/measureSession.ts",
    "measure:session-list": "tsx src/measureSessionList.ts",
    "measure:tasks": "tsx src/measureTaskOverhead.ts",
    "measure:tools": "tsx src/measureTools.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "test": "vitest run",
    "test:kb": "node ../../scripts/run-kb-tests.mjs server",
    "test:watch": "vitest",
    "migrations:lock": "tsx src/db/updateMigrationsLock.ts",
    "typecheck": "tsc --noEmit",
    "worktree-comments:sweep": "tsx src/db/sweepWorktreeComments.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@assistant/shared": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@mozilla/readability": "catalog:",
    "@opendocsg/pdf2md": "catalog:",
    "@parcel/watcher": "catalog:",
    "@playwright/mcp": "catalog:",
    "approx-string-match": "catalog:",
    "jsdom": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "node-forge": "catalog:",
    "turndown": "catalog:",
    "typebox": "catalog:",
    "unpdf": "catalog:",
    "web-push": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/node-forge": "catalog:",
    "@types/turndown": "catalog:",
    "@types/web-push": "catalog:",
    "@types/ws": "catalog:",
    "oxc-parser": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
