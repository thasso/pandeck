/target/
# Per-deployment bundle identity and signing settings, merged by the Tauri CLI.
/tauri.local.json
# The packaged server copied in for a local-mode build (`tauri.local-runtime.json`).
/local-runtime/
# Generated by `cargo tauri ios init` / `android init`. The Swift sources we own
# live under `ios/` and are copied in; the generated project is not source.
/gen/
